{
  "name": "biblenote",
  "version": "4.0.54",
  "description": "BibleNote desktop and OneNote cache application.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "onenote-mcp": "./dist/server.js"
  },
  "main": "./dist/electron-main.js",
  "scripts": {
    "build": "tsc",
    "test": "tsx --import ./tests/test-env.ts --test tests/*.test.ts",
    "e2e": "playwright test",
    "e2e:all": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:notes": "playwright test --grep @notes",
    "e2e:search": "playwright test --grep @search",
    "e2e:bible": "playwright test --grep @bible",
    "e2e:inductive": "playwright test --grep @inductive",
    "e2e:sync": "playwright test --grep @sync",
    "e2e:settings": "playwright test --grep @settings",
    "e2e:electron": "playwright test --grep @electron",
    "e2e:changed": "node scripts/e2e-changed.mjs",
    "e2e:install": "playwright install chromium",
    "verify:e2e": "npm run build && npm test && npm run e2e:all",
    "biblenote:stage": "powershell -ExecutionPolicy Bypass -File scripts/stage-biblenote.ps1",
    "node:stage": "powershell -ExecutionPolicy Bypass -File scripts/stage-node.ps1",
    "onenote-ribbon:stage": "powershell -ExecutionPolicy Bypass -File scripts/stage-onenote-ribbon.ps1",
    "node:rebuild": "npm rebuild better-sqlite3",
    "electron:dev": "npm run node:rebuild && npm run build && electron dist/electron-main.js",
    "electron:rebuild": "electron-builder install-app-deps",
    "version:bump": "node scripts/bump-version.mjs",
    "dist:portable": "npm run version:bump && npm run node:rebuild && npm run node:stage && npm run biblenote:stage && npm run onenote-ribbon:stage && npm run build && electron-builder --win portable",
    "dist:installer": "npm run version:bump && npm run node:rebuild && npm run node:stage && npm run biblenote:stage && npm run onenote-ribbon:stage && npm run build && electron-builder --win nsis",
    "dist:win": "npm run version:bump && npm run node:rebuild && npm run node:stage && npm run biblenote:stage && npm run onenote-ribbon:stage && npm run build && electron-builder --win nsis portable",
    "stage:mac:arm64": "node scripts/stage-mac-arm64.mjs",
    "dist:mac:arm64": "npm run stage:mac:arm64 && npm run build && python scripts/package-mac-arm64.py",
    "dist:mac:arm64:native": "npm run stage:mac:arm64 && npm run build && electron-builder --config electron-builder.mac-arm64.cjs --mac --arm64",
    "login": "tsx src/login.ts",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "sync": "tsx src/sync.ts",
    "cache:status": "tsx src/sync.ts --status",
    "cache:ui": "tsx src/cache-ui.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^5.0.6",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.4.624",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "build": {
    "appId": "local.biblenote",
    "productName": "BibleNote",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "ui/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/BibleNote",
        "to": "BibleNote",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/node",
        "to": "node",
        "filter": [
          "node.exe"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "icon": "assets/biblenote.ico",
      "extraResources": [
        {
          "from": "vendor/OneNoteRibbon",
          "to": "OneNoteRibbon",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BibleNote",
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "${productName} ${version}.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
